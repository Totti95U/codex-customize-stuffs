{
  "description": "Personal workflow guardrails",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy;from pathlib import Path;runpy.run_path(str(Path(os.environ.get('CODEX_HOME') or Path.home()/'.codex')/'hooks'/'evening-exploration.py'),run_name='__main__')\"",
            "commandWindows": "py -3 -c \"import os,runpy;from pathlib import Path;runpy.run_path(str(Path(os.environ.get('CODEX_HOME') or Path.home()/'.codex')/'hooks'/'evening-exploration.py'),run_name='__main__')\"",
            "timeout": 3,
            "statusMessage": "Checking evening exploration policy",
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
